# App
APP_ENV=development
APP_DEBUG=true
APP_MODE=mock
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
LOG_FORMAT=human

# Database
DB_URL=sqlite+aiosqlite:///./data/app.db

# WordPress (Phase 2)
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# WooCommerce (Phase 2)
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# AI (optional)
# Set AI_PROVIDER to "openai" and provide AI_API_KEY to enable.
# Leave as "none" to use the mock provider.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Image Search (optional)
IMAGE_SEARCH_PROVIDER=none
IMAGE_SEARCH_API_KEY=

# HTTP
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3